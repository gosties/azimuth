FROM trinodb/trino:484@sha256:2704eb53935af5e582d63d6033e9bf99d20c325e9b0e30b1016ef59a4773979f AS plugins
USER root
RUN mkdir /selected-plugins \
    && cp -a /usr/lib/trino/plugin/iceberg /usr/lib/trino/plugin/resource-group-managers /usr/lib/trino/plugin/blob-cache-alluxio /selected-plugins/

FROM trinodb/trino:484@sha256:2704eb53935af5e582d63d6033e9bf99d20c325e9b0e30b1016ef59a4773979f
USER root
# This service only reads Iceberg. Remove unused connector entry points and demo catalogs.
RUN rm -rf /usr/lib/trino/plugin /usr/lib/trino/secrets-plugin /etc/trino/catalog \
    && mkdir -p /usr/lib/trino/plugin /usr/lib/trino/secrets-plugin /etc/trino/catalog
COPY --from=plugins --chown=trino:trino /selected-plugins/ /usr/lib/trino/plugin/
USER trino
