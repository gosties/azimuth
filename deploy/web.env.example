BIND_ADDRESS=127.0.0.1
WEB_PORT=8156
AZIMUTH_TRUSTED_TUNNEL_IP=127.0.0.1
AZIMUTH_TRUSTED_LOOPBACK_IP=::1
TRINO_PORT=8096
TRINO_BIND_ADDRESS=127.0.0.1

# Trino container limits. Keep memory above JVM heap plus native overhead.
# JVM heap and query limits are configured separately in deploy/trino/.
TRINO_MEMORY_LIMIT=24g
TRINO_CPU_LIMIT=16

# Allowed basemap origins for browser image and network requests. Add an origin before configuring a map on a new host.
AZIMUTH_MAP_SOURCES="https://a.tile.opentopomap.org https://basemap.nationalmap.gov https://gibs.earthdata.nasa.gov https://server.arcgisonline.com https://tile.openstreetmap.org"
