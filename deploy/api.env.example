H3SEARCH_MODE=live
H3SEARCH_POSTGRES_DSN=postgresql://h3search:REPLACE_WITH_PASSWORD@control-db:5432/h3search
# Required for ETL/object-store operations; keep aligned with the catalog/Trino.
H3SEARCH_S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
H3SEARCH_S3_SECRET_KEY=REPLACE_WITH_SECRET
H3SEARCH_TRINO_HOST=trino
H3SEARCH_TRINO_PORT=8080
H3SEARCH_TRINO_CATALOG=iceberg
H3SEARCH_TRINO_SCHEMA=h3search
H3SEARCH_POOL_SIZE=4
H3SEARCH_QUERY_TIMEOUT_SEC=60
H3SEARCH_LOG_LEVEL=INFO
# SQL profiles belong in the optional server-side TOML, mounted by compose.sql.yml.
# Do not set H3SEARCH_CONNECTIONS here: it would replace every TOML SQL profile.
H3SEARCH_AUTH_ORIGINS=["https://search.example.org"]
H3SEARCH_AUTH_COOKIE_SECURE=true
# Replace with the trusted reverse proxy address or its container network CIDR.
FORWARDED_ALLOW_IPS=127.0.0.1
